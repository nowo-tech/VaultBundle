{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell (@NowoUiKit/demo_platform/layout.html.twig):
    the same top bar, aside, content width, theme and footer as every other nowo-tech bundle demo. This file only
    declares the demo (nowo_ui_demo_platform); the Vault pages render through it too (nowo_ui_kit.layouts). -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set nowo_ui_demo_platform = {
    bundle: 'Vault',
    home_route: 'nowo_vault_index',
    repository: 'https://github.com/nowo-tech/VaultBundle',
    translation_domain: false,
    locales: [],
    nav: [
        {label: 'Home', route: 'nowo_vault_index'},
        {label: 'My items', route: 'nowo_vault_items', active: ['nowo_vault_items', 'nowo_vault_item_*'], section: 'Vault'},
        {label: 'Shared', route: 'nowo_vault_shared', section: 'Vault'},
        {label: 'Trash', route: 'nowo_vault_trash', section: 'Vault'},
    ],
} %}

{% block nowo_ui_document_title %}{% block title %}Vault Bundle Demo{% endblock %} — Symfony 8{% endblock %}
