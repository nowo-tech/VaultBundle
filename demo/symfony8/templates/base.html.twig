{#- REQ-DEMO-014: the demo shell is UiKit's admin layout with UiKit's default theme (nowo-ui.css from the bundle's own
    asset package, no CSS framework, no CDN, inline SVG icons). The Vault pages render in it too
    (nowo_ui_kit.layouts.admin). -#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}Vault Bundle Demo{% endblock %}{% endblock %}

{% block nowo_ui_navigation %}
    {% set _route = app.request.attributes.get('_route')|default('') %}
    <header class="nowo-ui-header" data-testid="demo-masthead">
        <a class="nowo-ui-brand" href="{{ path('nowo_vault_index') }}">Vault Bundle Demo</a>
        <nav class="nowo-ui-menu" aria-label="Vault Bundle">
            <a class="nowo-ui-link" href="{{ path('nowo_vault_index') }}"{% if _route == 'nowo_vault_index' %} aria-current="page"{% endif %}>Home</a>
            <a class="nowo-ui-link" href="{{ path('nowo_vault_items') }}"{% if _route == 'nowo_vault_items' %} aria-current="page"{% endif %}>My items</a>
            <a class="nowo-ui-link" href="{{ path('nowo_vault_shared') }}"{% if _route == 'nowo_vault_shared' %} aria-current="page"{% endif %}>Shared</a>
            <a class="nowo-ui-link" href="{{ path('nowo_vault_trash') }}"{% if _route == 'nowo_vault_trash' %} aria-current="page"{% endif %}>Trash</a>
        </nav>
        <div class="nowo-ui-header__end">
            {{ include('@NowoUiKitBundle/partials/_theme_toggle.html.twig', { compact: true }, false) }}
        </div>
    </header>
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}
