{#
  Share access (REQ-UI-003): UiKit form scaffold. Variable: page (View\FormPage from VaultPageFactory::share(): header
  vault.share.title (intro = item title / folder name) with a back link; form = VaultShareType (grantee picker or
  grantee type + id, permission); submit vault.share.submit; cancel = back). Also: grantsTable (View\Table from
  VaultPageFactory::grantsTable(): grantee type, grantee, permission; row action Remove access = POST + CSRF FormView
  behind a Confirm), grants, granteeLabels (type:id => label), sharingAvailable (false: no grantee can be granted),
  expiredGrants (1.16.0: grant id => expired, not yet purged).
  Data blocks filled: nowo_ui_form_body (intro, the REQ-TWIG-003 child loop, the grantee id help),
  nowo_ui_form_aside (current grants through the UiKit `table` partial, or the empty message).
#}
{% extends '@NowoUiKit/page/form.html.twig' %}
{% trans_default_domain 'NowoVaultBundle' %}

{% block nowo_ui_form_body %}
    {% set _b = page.bundle %}
    <p class="{{ nowo_ui_class('muted', _b) }}">{{ 'vault.access.intro'|trans }}</p>
    {% if sharingAvailable is defined and not sharingAvailable %}
        {# 1.15.2: no GRANT_LIST_QUERY listener listed grantees, and unlisted grantees are refused (fail closed). #}
        <div class="{{ nowo_ui_class('flash_info', _b) }}" role="status" data-testid="vault-share-unavailable">{{ 'vault.share.not_configured'|trans }}</div>
    {% endif %}
    {{ parent() }}
    {% if not form.vars.grantee_picker|default(false) %}
        <p class="{{ nowo_ui_class('muted', _b) }}">{{ 'vault.share.grantee_id_help'|trans }}</p>
    {% endif %}
{% endblock %}

{% block nowo_ui_form_aside %}
    {% set _b = page.bundle %}
    <aside class="{{ nowo_ui_class('card', _b) }} vault-grants" data-testid="vault-grants-panel"{{ nowo_ui_attrs('card', _b) }}>
        <header class="{{ nowo_ui_class('card_header', _b) }}">
            <h2 class="{{ nowo_ui_class('card_title', _b) }}">{{ 'vault.share.existing'|trans }}</h2>
        </header>
        <div class="{{ nowo_ui_class('card_body', _b) }}">
            {% if grants is empty %}
                <p class="{{ nowo_ui_class('empty', _b) }}">{{ 'vault.access.empty'|trans }}</p>
            {% else %}
                {% embed nowo_ui_partial('table', _b) with {table: grantsTable, bundle: _b} %}
                    {% block nowo_ui_table_row %}
                        {% set _cell = nowo_ui_class('table_cell', bundle) %}
                        {% set _key = row.granteeType.value ~ ':' ~ row.granteeId %}
                        <td class="{{ _cell }}" data-label="{{ 'vault.share.grantee_type'|trans({}, 'NowoVaultBundle') }}">{{ ('vault.grantee_type.' ~ row.granteeType.value)|trans({}, 'NowoVaultBundle') }}</td>
                        <td class="{{ _cell }}" data-label="{{ 'vault.share.grantee_id'|trans({}, 'NowoVaultBundle') }}" data-required="1">
                            {% if granteeLabels[_key]|default('') %}
                                {{ granteeLabels[_key] }} <code class="{{ nowo_ui_class('code', bundle) }}">{{ row.granteeId }}</code>
                            {% else %}
                                <code class="{{ nowo_ui_class('code', bundle) }}">{{ row.granteeId }}</code>
                            {% endif %}
                        </td>
                        <td class="{{ _cell }}" data-label="{{ 'vault.share.permission'|trans({}, 'NowoVaultBundle') }}">
                            {{ ('vault.permission.' ~ row.permission.value)|trans({}, 'NowoVaultBundle') }}
                            {% if row.expiresAt %}
                                {# 1.16.0: temporary grant; expired ones give no access already and stay listed until the purge. #}
                                <span class="{{ nowo_ui_class('muted', bundle) }}" data-testid="vault-grant-expiry">{{ 'vault.share.until'|trans({'%date%': row.expiresAt|date('Y-m-d H:i')}, 'NowoVaultBundle') }}</span>
                                {% if expiredGrants[row.id]|default(false) %}
                                    <span class="{{ nowo_ui_class('badge_neutral', bundle) }}" data-testid="vault-grant-expired">{{ 'vault.share.expired'|trans({}, 'NowoVaultBundle') }}</span>
                                {% endif %}
                            {% endif %}
                        </td>
                    {% endblock %}
                {% endembed %}
            {% endif %}
        </div>
    </aside>
{% endblock %}
