{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set _vault_fw = nowo_vault_css_framework|default('tabler') %}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="{{ ui.flash(label == 'success' ? 'success' : 'danger', _vault_fw) }}">{{ message }}</div>
    {% endfor %}
{% endfor %}
