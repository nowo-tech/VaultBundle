{% extends '@NowoVaultBundle/vault/base.html.twig' %}

{% block title %}{{ 'vault.nav.trash'|trans({}, 'NowoVaultBundle') }}{% endblock %}

{% block body %}
    {% include '@NowoVaultBundle/vault/_page_header.html.twig' with {
        pageTitle: 'vault.nav.trash'|trans({}, 'NowoVaultBundle'),
        pageSubtitle: 'vault.home.trash.description'|trans({}, 'NowoVaultBundle'),
    } %}

    {% include '@NowoVaultBundle/vault/_flashes.html.twig' %}

    <div class="card">
        <div class="card-body p-0">
            {% if items is empty %}
                <p class="text-secondary p-4 mb-0">{{ 'vault.empty.trash'|trans({}, 'NowoVaultBundle') }}</p>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-vcenter card-table mb-0">
                        <thead>
                            <tr>
                                <th>{{ 'vault.form.title'|trans({}, 'NowoVaultBundle') }}</th>
                                <th class="w-1"></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in items %}
                                <tr>
                                    <td>{{ item.title }}</td>
                                    <td class="text-end text-nowrap">
                                        {# REQ-TWIG-005: CSRF-only VaultActionType forms (restoreForms / purgeForms). #}
                                        {% set restore_form = restoreForms[item.id] %}
                                        {{ form_start(restore_form, {attr: {class: 'd-inline'}}) }}
                                            {% for child in restore_form %}
                                                {% if not child.rendered %}
                                                    {{ form_row(child) }}
                                                {% endif %}
                                            {% endfor %}
                                            <button type="submit" class="btn btn-sm btn-outline-primary">{{ 'vault.action.restore'|trans({}, 'NowoVaultBundle') }}</button>
                                                                                {{ form_end(restore_form) }}
                                        {% set purge_form = purgeForms[item.id] %}
                                        {{ form_start(purge_form, {attr: {class: 'd-inline'}}) }}
                                            {% for child in purge_form %}
                                                {% if not child.rendered %}
                                                    {{ form_row(child) }}
                                                {% endif %}
                                            {% endfor %}
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('{{ 'vault.confirm.purge'|trans({}, 'NowoVaultBundle')|e('js') }}');">
                                                {{ 'vault.action.purge'|trans({}, 'NowoVaultBundle') }}
                                            </button>
                                                                                {{ form_end(purge_form) }}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% include '@NowoVaultBundle/vault/_pagination.html.twig' with {pagination: pagination|default(null), routeName: routes.trash.name} %}
            {% endif %}
        </div>
    </div>
{% endblock %}
