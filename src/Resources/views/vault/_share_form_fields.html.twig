{#
  Share form fields inside a Bootstrap grid row. The FormType adds either granteeSelection + permission (grantee
  picker) or granteeType + granteeId + permission; the child loop (REQ-TWIG-003) renders whichever exist, each in its
  grid column. Hidden children (CSRF token) are left to the caller's loop / form_end.
#}
{% set _vault_share_cols = {granteeSelection: 'col-md-8'} %}
{% for child in form %}
    {% if not child.rendered and 'hidden' not in child.vars.block_prefixes %}
        <div class="{{ _vault_share_cols[child.vars.name]|default('col-md-4') }}">{{ form_row(child) }}</div>
    {% endif %}
{% endfor %}
