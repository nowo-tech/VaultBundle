{#
  Password generator dialog. Owner rule 2026-11-23 (every dialog loads its content on demand): the content of the GET of
  `password_generate` for UiKit's remote dialog (`X-Nowo-Dialog: 1`, the empty shell `vault-password-generator` of the home page),
  with a first password already generated. REQ-TWIG-005: browser-only VaultPasswordGeneratorType (generatorForm); vault.js
  reads the data-vault-password-* hooks (endpoint URL and CSRF token on the root element) and the vault-gen-mode radios, and
  never submits the form. The footer actions move into the dialog footer.
  Variables: generatorForm, password (the first one), strength, routes, bundle.
#}
{% trans_default_domain 'NowoVaultBundle' %}
{% set _b = bundle|default(null) %}
{# `only`: a host Bootstrap form theme renders checkbox / radio labels inside the widget and empty from form_label. #}
{% form_theme generatorForm with ['form_div_layout.html.twig'] only %}
{% set _body %}
    {{ form_start(generatorForm, {attr: {class: 'vault-generator', autocomplete: 'off', 'data-vault-password-form': true}}) }}
        <div class="{{ nowo_ui_class('toolbar', _b) }} vault-generator__output"{{ nowo_ui_attrs('toolbar', _b) }}>
            {{ form_widget(generatorForm.output, {value: password|default(''), attr: {autofocus: 'autofocus'}}) }}
            <button type="button" class="{{ nowo_ui_class('btn_secondary', _b) }}" data-vault-password-regenerate>{{ 'vault.generator.regenerate'|trans }}</button>
            <button type="button" class="{{ nowo_ui_class('btn_secondary', _b) }}" data-vault-password-copy>{{ 'vault.generator.copy'|trans }}</button>
        </div>
        <p class="{{ nowo_ui_class('muted', _b) }}" data-vault-password-strength aria-live="polite">{{ strength|default('') }}</p>
        <div class="vault-generator__field">
            {{ form_label(generatorForm.length) }}
            {{ form_widget(generatorForm.length) }}
        </div>
        <fieldset class="vault-generator__options">
            {% for mode in generatorForm.mode %}
                <span class="{{ nowo_ui_class('check', _b) }}">
                    {{ form_widget(mode) }}
                    {{ form_label(mode) }}
                </span>
            {% endfor %}
        </fieldset>
        <fieldset class="vault-generator__options">
            {% for option in [generatorForm.upper, generatorForm.digits, generatorForm.symbols] %}
                <span class="{{ nowo_ui_class('check', _b) }}">
                    {{ form_widget(option) }}
                    {{ form_label(option) }}
                </span>
            {% endfor %}
        </fieldset>
        {% for child in generatorForm %}
            {% if not child.rendered %}
                {{ form_row(child) }}
            {% endif %}
        {% endfor %}
    {{ form_end(generatorForm) }}
{% endset %}
{% set _footer %}
    <button type="button" class="{{ nowo_ui_class('btn_secondary', _b) }}" data-nowo-ui-dialog-close>{{ 'vault.action.cancel'|trans }}</button>
    <button type="button" class="{{ nowo_ui_class('btn_primary', _b) }}" data-vault-password-fill>{{ 'vault.generator.fill'|trans }}</button>
{% endset %}
<div data-vault-password-modal data-vault-password-url="{{ path(routes.password_generate.name) }}" data-vault-password-csrf="{{ csrf_token('vault_password_generate') }}" data-testid="vault-password-generator-content">
    {{ _body }}
</div>
<div class="{{ nowo_ui_class('form_actions', _b) }}" data-nowo-ui-dialog-actions>{{ _footer }}</div>
