{# REQ-TWIG-005: browser-only VaultPasswordGeneratorType (generatorForm); vault.js reads the data-vault-password-* hooks and the vault-gen-mode radios. Never submitted. #}
<div class="vault-password-modal" data-vault-password-modal hidden>
    <div class="vault-password-modal-backdrop" data-vault-password-close></div>
    <div class="vault-password-modal-panel card shadow-sm" role="dialog" aria-modal="true">
        <div class="card-header d-flex align-items-center justify-content-between">
            <h3 class="card-title mb-0">{{ 'vault.generator.title'|trans({}, 'NowoVaultBundle') }}</h3>
            <button type="button" class="btn-close" data-vault-password-close aria-label="Close"></button>
        </div>
        {# `only`: a host Bootstrap form theme renders checkbox / radio labels inside the widget and empty from form_label. #}
        {% form_theme generatorForm with ['form_div_layout.html.twig'] only %}
        {{ form_start(generatorForm, {attr: {class: 'card-body', autocomplete: 'off', onsubmit: 'return false;'}}) }}
            <div class="input-group mb-3">
                {{ form_widget(generatorForm.output) }}
                <button type="button" class="btn btn-outline-secondary" data-vault-password-regenerate>{{ 'vault.generator.regenerate'|trans({}, 'NowoVaultBundle') }}</button>
                <button type="button" class="btn btn-outline-secondary" data-vault-password-copy>{{ 'vault.generator.copy'|trans({}, 'NowoVaultBundle') }}</button>
            </div>
            <p class="text-secondary small" data-vault-password-strength></p>
            <div class="mb-3">
                {{ form_label(generatorForm.length) }}
                {{ form_widget(generatorForm.length) }}
            </div>
            <fieldset class="mb-3">
                {% for mode in generatorForm.mode %}
                    <div class="form-check">
                        {{ form_widget(mode) }}
                        {{ form_label(mode, null, {label_attr: {class: 'form-check-label'}}) }}
                    </div>
                {% endfor %}
            </fieldset>
            <fieldset class="mb-3">
                {% for option in [generatorForm.upper, generatorForm.digits, generatorForm.symbols] %}
                    <div class="form-check form-check-inline">
                        {{ form_widget(option) }}
                        {{ form_label(option, null, {label_attr: {class: 'form-check-label'}}) }}
                    </div>
                {% endfor %}
            </fieldset>
            {% for child in generatorForm %}
                {% if not child.rendered %}
                    {{ form_row(child) }}
                {% endif %}
            {% endfor %}
            <button type="button" class="btn btn-primary" data-vault-password-fill>{{ 'vault.generator.fill'|trans({}, 'NowoVaultBundle') }}</button>
        {{ form_end(generatorForm) }}
    </div>
</div>
