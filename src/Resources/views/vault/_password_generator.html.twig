{#
  Password generator dialog (REQ-UI-003: the UiKit `dialog` partial — native <dialog>, header / body / footer; opened by
  any [data-nowo-ui-dialog-open="vault-password-generator"]). REQ-TWIG-005: browser-only VaultPasswordGeneratorType
  (generatorForm); vault.js reads the data-vault-password-* hooks (endpoint URL and CSRF token on the <dialog>) and the
  vault-gen-mode radios, and never submits the form.
  Variables: generatorForm, routes, bundle.
#}
{% trans_default_domain 'NowoVaultBundle' %}
{% set _b = bundle|default(null) %}
{# `only`: a host Bootstrap form theme renders checkbox / radio labels inside the widget and empty from form_label. #}
{% form_theme generatorForm with ['form_div_layout.html.twig'] only %}
{% set _body %}
    {{ form_start(generatorForm, {attr: {class: 'vault-generator', autocomplete: 'off', 'data-vault-password-form': true}}) }}
        <div class="{{ nowo_ui_class('toolbar', _b) }} vault-generator__output"{{ nowo_ui_attrs('toolbar', _b) }}>
            {{ form_widget(generatorForm.output) }}
            <button type="button" class="{{ nowo_ui_class('btn_secondary', _b) }}" data-vault-password-regenerate>{{ 'vault.generator.regenerate'|trans }}</button>
            <button type="button" class="{{ nowo_ui_class('btn_secondary', _b) }}" data-vault-password-copy>{{ 'vault.generator.copy'|trans }}</button>
        </div>
        <p class="{{ nowo_ui_class('muted', _b) }}" data-vault-password-strength aria-live="polite"></p>
        <div class="vault-generator__field">
            {{ form_label(generatorForm.length) }}
            {{ form_widget(generatorForm.length) }}
        </div>
        <fieldset class="vault-generator__options">
            {% for mode in generatorForm.mode %}
                <span class="{{ nowo_ui_class('check', _b) }}">
                    {{ form_widget(mode) }}
                    {{ form_label(mode) }}
                </span>
            {% endfor %}
        </fieldset>
        <fieldset class="vault-generator__options">
            {% for option in [generatorForm.upper, generatorForm.digits, generatorForm.symbols] %}
                <span class="{{ nowo_ui_class('check', _b) }}">
                    {{ form_widget(option) }}
                    {{ form_label(option) }}
                </span>
            {% endfor %}
        </fieldset>
        {% for child in generatorForm %}
            {% if not child.rendered %}
                {{ form_row(child) }}
            {% endif %}
        {% endfor %}
    {{ form_end(generatorForm) }}
{% endset %}
{% set _footer %}
    <button type="button" class="{{ nowo_ui_class('btn_secondary', _b) }}" data-nowo-ui-dialog-close>{{ 'vault.action.cancel'|trans }}</button>
    <button type="button" class="{{ nowo_ui_class('btn_primary', _b) }}" data-vault-password-fill>{{ 'vault.generator.fill'|trans }}</button>
{% endset %}
{{ include(nowo_ui_partial('dialog', _b), {
    id: 'vault-password-generator',
    title: 'vault.generator.title'|trans,
    body: _body,
    footer: _footer,
    bundle: _b,
    attr: {
        'data-vault-password-modal': true,
        'data-vault-password-url': path(routes.password_generate.name),
        'data-vault-password-csrf': csrf_token('vault_password_generate'),
        'data-testid': 'vault-password-generator',
    },
}, false) }}
