{% extends '@NowoVaultBundle/vault/base.html.twig' %}

{% block title %}{{ 'vault.runtime_config.title'|trans({}, 'NowoVaultBundle') }}{% endblock %}

{% block body %}
    {% include '@NowoVaultBundle/vault/_page_header.html.twig' with {
        pageTitle: 'vault.runtime_config.title'|trans({}, 'NowoVaultBundle'),
        pageSubtitle: 'vault.runtime_config.intro'|trans({}, 'NowoVaultBundle'),
        routes: routes,
        dashboardRoute: dashboardRoute,
    } %}

    {% include '@NowoVaultBundle/vault/_flashes.html.twig' %}

    <div class="row row-cards">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title mb-0">{{ 'vault.runtime_config.section'|trans({}, 'NowoVaultBundle') }}</h3>
                </div>
                <div class="card-body">
                    {% if dbUpdatedAt %}
                        <p class="text-secondary small">{{ 'vault.runtime_config.last_update'|trans({'%datetime%': dbUpdatedAt|date('Y-m-d H:i:s') ~ ' UTC'}, 'NowoVaultBundle') }}</p>
                    {% endif %}

                    {# REQ-TWIG-005: VaultRuntimeConfigType (flat encryption_key / max_attachment_bytes / password_level / _token). #}
                    {{ form_start(form) }}
                        <div class="mb-3">
                            {% if form.encryption_key is defined %}
                                {{ form_label(form.encryption_key) }}
                            {% else %}
                                <span class="form-label d-block">{{ 'vault.runtime_config.encryption_key'|trans({}, 'NowoVaultBundle') }}</span>
                            {% endif %}
                            {% if showOneTimeKeyWarning %}
                                <div class="alert alert-warning" role="alert">
                                    {{ 'vault.runtime_config.encryption_key_one_time_warning'|trans({}, 'NowoVaultBundle') }}
                                </div>
                                {{ form_widget(form.encryption_key) }}
                            {% elseif hasDbEncryptionKey or hasYamlEncryptionKey %}
                                {{ form_widget(form.encryption_key) }}
                                <div class="form-text">
                                    {% if hasDbEncryptionKey %}
                                        {{ 'vault.runtime_config.encryption_key_stored_help'|trans({}, 'NowoVaultBundle') }}
                                    {% else %}
                                        {{ 'vault.runtime_config.encryption_key_yaml_help'|trans({}, 'NowoVaultBundle') }}
                                    {% endif %}
                                </div>
                            {% elseif not canStoreEncryptionKey %}
                                <div class="alert alert-warning" role="alert">
                                    {{ 'vault.runtime_config.encryption_key_storage_unavailable'|trans({}, 'NowoVaultBundle') }}
                                </div>
                            {% else %}
                                {{ form_widget(form.encryption_key) }}
                                <div class="form-text">
                                    {{ 'vault.runtime_config.encryption_key_empty_help'|trans({}, 'NowoVaultBundle') }}
                                </div>
                                <div class="d-flex flex-wrap gap-2 mt-2">
                                    <button type="submit"
                                            name="generate_encryption_key"
                                            value="1"
                                            class="btn btn-outline-primary"
                                            formaction="{{ path(runtimeConfigRoute) }}"
                                            formnovalidate>
                                        {{ 'vault.runtime_config.generate_key'|trans({}, 'NowoVaultBundle') }}
                                    </button>
                                </div>
                            {% endif %}
                        </div>

                        {% for child in form %}
                            {% if not child.rendered %}
                                {{ form_row(child) }}
                            {% endif %}
                        {% endfor %}

                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-primary">{{ 'vault.action.save'|trans({}, 'NowoVaultBundle') }}</button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
