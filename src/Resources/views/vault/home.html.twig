{#
  Vault home (REQ-UI-003): UiKit dashboard scaffold. Variable: page (View\DashboardPage from VaultPageFactory::home():
  header vault.title / vault.home.intro, the Open settings action for admins when the database-backed configuration
  is enabled, a back link to web_ui dashboard_route when set). Also: routes (nowo_vault.routes), itemTypes
  (list<VaultItemType>), generatorForm (VaultPasswordGeneratorType FormView).
  Data block filled: nowo_ui_dashboard_cards (My items / Shared / Trash, create an entry per type, password generator).
  The generator <dialog> is printed in nowo_ui_modals (_password_generator.html.twig).
#}
{% extends '@NowoUiKit/page/dashboard.html.twig' %}
{% trans_default_domain 'NowoVaultBundle' %}

{% block nowo_ui_styles %}{{ parent() }}<link rel="stylesheet" href="{{ asset('vault.css', 'nowo_vault') }}">{% endblock %}

{% block nowo_ui_dashboard_cards %}
    {% set _b = page.bundle %}
    {% for section in [
        {key: 'items', title: 'vault.home.items.title', description: 'vault.home.items.description', route: routes.items.name},
        {key: 'shared', title: 'vault.nav.shared', description: 'vault.home.shared.description', route: routes.shared.name},
        {key: 'trash', title: 'vault.nav.trash', description: 'vault.home.trash.description', route: routes.trash.name},
    ] %}
        <section class="{{ nowo_ui_class('card', _b) }} vault-home-card" data-testid="vault-home-{{ section.key }}"{{ nowo_ui_attrs('card', _b) }}>
            <header class="{{ nowo_ui_class('card_header', _b) }}">
                <h2 class="{{ nowo_ui_class('card_title', _b) }}">{{ section.title|trans }}</h2>
            </header>
            <div class="{{ nowo_ui_class('card_body', _b) }}">
                <p class="{{ nowo_ui_class('card_intro', _b) }}">{{ section.description|trans }}</p>
                <a class="{{ nowo_ui_class('btn_secondary', _b) }}" href="{{ path(section.route) }}">{{ 'vault.action.open'|trans }}</a>
            </div>
        </section>
    {% endfor %}

    <section class="{{ nowo_ui_class('card', _b) }} vault-home-card" data-testid="vault-home-create"{{ nowo_ui_attrs('card', _b) }}>
        <header class="{{ nowo_ui_class('card_header', _b) }}">
            <h2 class="{{ nowo_ui_class('card_title', _b) }}">{{ 'vault.home.create.title'|trans }}</h2>
        </header>
        <div class="{{ nowo_ui_class('card_body', _b) }}">
            <p class="{{ nowo_ui_class('card_intro', _b) }}">{{ 'vault.home.create.description'|trans }}</p>
            <div class="{{ nowo_ui_class('toolbar', _b) }}"{{ nowo_ui_attrs('toolbar', _b) }}>
                {% for type in itemTypes %}
                    <a class="{{ nowo_ui_class('btn_secondary', _b) }}" href="{{ path(routes.item_new.name, {type: type.value}) }}">{{ ('vault.type.' ~ type.value)|trans }}</a>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="{{ nowo_ui_class('card', _b) }} vault-home-card" data-testid="vault-home-generator"{{ nowo_ui_attrs('card', _b) }}>
        <header class="{{ nowo_ui_class('card_header', _b) }}">
            <h2 class="{{ nowo_ui_class('card_title', _b) }}">{{ 'vault.nav.password_generator'|trans }}</h2>
        </header>
        <div class="{{ nowo_ui_class('card_body', _b) }}">
            <p class="{{ nowo_ui_class('card_intro', _b) }}">{{ 'vault.home.generator.description'|trans }}</p>
            <button type="button" class="{{ nowo_ui_class('btn_primary', _b) }}" data-vault-password-generator data-nowo-ui-dialog-open="vault-password-generator" aria-haspopup="dialog" aria-controls="vault-password-generator">{{ 'vault.nav.password_generator'|trans }}</button>
        </div>
    </section>
{% endblock %}

{% block nowo_ui_modals %}
    {{ parent() }}
    {{ include('@NowoVaultBundle/vault/_password_generator.html.twig', {bundle: page.bundle}) }}
{% endblock %}

{% block nowo_ui_scripts %}{{ parent() }}<script type="module" src="{{ asset('vault.js', 'nowo_vault') }}"></script>{% endblock %}
