<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}" class="nowo-ui-root nowo-ui-css-{{ nowo_vault_css_framework|default('tabler') }}" data-css-framework="{{ nowo_vault_css_framework|default('tabler') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ 'vault.title'|trans({}, 'NowoVaultBundle') }}{% endblock %}</title>
    {# Demo root layout: no parent() (full HTML). Package assets stack in vault/base.html.twig. #}
    {% block styles %}
        {% block stylesheets %}
            {% set _vault_css = nowo_vault_css_framework|default('tabler') %}
            {% if _vault_css in ['tabler', 'bootstrap', 'bootstrap5', 'bootstrap4'] %}
                <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/core@1.0.0-beta20/dist/css/tabler.min.css">
                <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
            {% endif %}
        {% endblock %}
    {% endblock %}
</head>
<body>
<div class="page">
    <div class="container container-narrow py-4">
        {% block body %}{% endblock %}
    </div>
</div>
{% block javascripts %}{% endblock %}
</body>
</html>
