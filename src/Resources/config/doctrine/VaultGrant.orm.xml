<?xml version="1.0" encoding="UTF-8"?>
<!-- Since 1.19.0: XML mapping of the vault entity (same tables, columns, indexes and constraints as its attributes).
     Used with nowo_vault.database.mapping_type: xml, or by a host that maps the vault entities itself. The table name
     prefix (table_prefix) and the host user associations (user_class / user_mapping) are applied at runtime by the
     bundle's metadata listener, exactly as for the attributes. -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\VaultBundle\Entity\VaultGrant" table="vault_grants">
        <indexes>
            <index name="vault_grants_expires_idx" columns="expires_at"/>
            <index name="vault_grants_grantee_idx" columns="grantee_type,grantee_id"/>
        </indexes>
        <unique-constraints>
            <unique-constraint name="vault_grants_unique" columns="resource_type,resource_id,grantee_type,grantee_id"/>
        </unique-constraints>
        <id name="id" type="string" length="36"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
        <field name="resourceType" column="resource_type" type="string" length="16" enum-type="Nowo\VaultBundle\Enum\VaultResourceType"/>
        <field name="resourceId" column="resource_id" type="string" length="36"/>
        <field name="granteeType" column="grantee_type" type="string" length="16" enum-type="Nowo\VaultBundle\Enum\GranteeType"/>
        <field name="granteeId" column="grantee_id" type="string" length="128"/>
        <field name="permission" type="string" length="16" enum-type="Nowo\VaultBundle\Enum\VaultPermission"/>
        <field name="expiresAt" column="expires_at" type="datetime_immutable" nullable="true"/>
        <many-to-one field="createdBy" target-entity="Symfony\Component\Security\Core\User\UserInterface">
            <join-column name="created_by_id" nullable="true" on-delete="SET NULL"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
